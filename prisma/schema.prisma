// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// RAAS access roles — matches the wireframe's 7 portals.
enum Role {
  public
  artist
  fan
  b2b_dev
  investor
  admin
  archivist
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Display name shown in the top nav and on pages.
  displayName  String
  /// scrypt-hashed password. Never sent to the client.
  passwordHash String
  /// The role this user is authorized for. Determines portal access.
  role         Role     @default(public)
  /// Optional artist slug — set when role=artist, links to a public artist territory.
  artistSlug   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}
